# .env.example — 실제 키를 여기에 쓰지 마세요!
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤, 실제 키 값을 넣으세요.
# cp .env.example .env

OPENAI_API_KEY=sk-proj-여기에_실제_키를_입력하세요

# --- 공개 전 필수 설정 (Vercel 환경변수에 직접 입력, 코드/채팅에 붙여넣지 마세요) ---
# 관리자 비밀번호 (10자 이상). 없으면 관리자 기능이 열리지 않습니다.
ADMIN_PASSWORD=
# 서비스 공개 스위치. 0 으로 설정해야 열립니다. 비워 두면 일시 중단 상태입니다.
APP_PAUSED=1
# Supabase (supabase_setup.sql 실행 필요)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# 선택: 월 AI 비용 경고선/차단선(원), 글자 수, 반복 제출 제한
# MONTHLY_WARN_KRW=16000
# MONTHLY_LIMIT_KRW=20000
# MAX_TEXT_CHARS=1500
# IP_LIMIT_COUNT=5
# IP_LIMIT_MINUTES=10
# GLOBAL_LIMIT_PER_HOUR=60
